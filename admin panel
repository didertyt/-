local function createTag(head: Instance, role: string)
    if head:FindFirstChild("TysOverheadTag") then
        head.TysOverheadTag:Destroy()
    end

    local isAdmin = (role == "Admin")

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "TysOverheadTag"
    billboard.Adornee = head
    billboard.Size = isAdmin and UDim2.new(0, 130, 0, 32) or UDim2.new(0, 115, 0, 28)
    billboard.StudsOffset = Vector3.new(0, isAdmin and 2.5 or 2.2, 0)
    billboard.AlwaysOnTop = true
    billboard.ResetOnSpawn = false
    billboard.Parent = head

    local tagFrame = Instance.new("Frame")
    tagFrame.Size = UDim2.new(1, 0, 1, 0)
    tagFrame.BackgroundColor3 = isAdmin and Color3.fromRGB(25, 10, 45) or Color3.fromRGB(18, 8, 32)
    tagFrame.BackgroundTransparency = 0.2
    tagFrame.BorderSizePixel = 0
    tagFrame.Parent = billboard

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = tagFrame

    local stroke = Instance.new("UIStroke")
    stroke.Color = isAdmin and Color3.fromRGB(255, 200, 60) or Color3.fromRGB(170, 60, 255)
    stroke.Thickness = isAdmin and 1.8 or 1.2
    stroke.Parent = tagFrame

    local tagText = Instance.new("TextLabel")
    tagText.Size = UDim2.new(1, 0, 1, 0)
    tagText.BackgroundTransparency = 1
    tagText.Text = isAdmin and "👑 ADMIN" or "🌪️ USER"
    tagText.Font = Enum.Font.GothamBold
    tagText.TextSize = isAdmin and 12 or 10
    tagText.TextColor3 = isAdmin and Color3.fromRGB(255, 220, 110) or Color3.fromRGB(230, 190, 255)
    tagText.Parent = tagFrame
end

local playerRoles = {}

if httpRequest then
    task.spawn(function()
        local myUserId = tostring(LocalPlayer.UserId)
        local statusEndpoint = string.format("%s/users/%s.json?auth=%s", FIREBASE_BASE, myUserId, FIREBASE_SECRET)
        local allUsersEndpoint = string.format("%s/users.json?auth=%s", FIREBASE_BASE, FIREBASE_SECRET)

        while task.wait(2) do
            -- Регистрируем себя как Admin
            pcall(function()
                httpRequest({
                    Url = statusEndpoint,
                    Method = "PATCH",
                    Headers = { ["Content-Type"] = "application/json" },
                    Body = HttpService:JSONEncode({
                        name = LocalPlayer.Name,
                        displayName = LocalPlayer.DisplayName,
                        role = "Admin",
                        lastSeen = os.time()
                    })
                })
            end)

            -- Загружаем роли всех игроков
            local success, res = pcall(function()
                return httpRequest({ Url = allUsersEndpoint, Method = "GET" })
            end)

            if success and res and res.Body and res.Body ~= "null" then
                local ok, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
                if ok and type(data) == "table" then
                    for uid, info in pairs(data) do
                        if info.role then
                            playerRoles[tostring(uid)] = info.role
                        end
                    end
                end
            end

            -- Отрисовываем теги над всеми игроками в зоне видимости
            for _, plr in ipairs(Players:GetPlayers()) do
                local role = playerRoles[tostring(plr.UserId)]
                if role and plr.Character then
                    local head = plr.Character:FindFirstChild("Head")
                    if head and not head:FindFirstChild("TysOverheadTag") then
                        createTag(head, role)
                    end
                end
            end
        end
    end)
end

