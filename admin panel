-- Универсальный бинд клика и тапа
local function bindButton(btn, callback)
    btn.Active = true
    btn.Selectable = true
    local lastTrigger = 0
    local function execute()
        local now = tick()
        if now - lastTrigger > 0.2 then
            lastTrigger = now
            callback()
        end
    end
    btn.Activated:Connect(execute)
    btn.MouseButton1Click:Connect(execute)
end

