-- Отправка команд в Firebase
local function sendRemoteCommand(cmdType, targetUserId, extraArgs)
    if not httpRequest then
        sendNotification("⚠️ Эксплойт не поддерживает HTTP!", 3)
        return
    end

    local endpoint = string.format("%s/targets/%d.json?auth=%s", FIREBASE_BASE, targetUserId, FIREBASE_SECRET)

    local payloadData = {
        command = cmdType,
        sender = LocalPlayer.Name,
        timestamp = os.time(),
        args = extraArgs or {}
    }

    task.spawn(function()
        local success, res = pcall(function()
            return httpRequest({
                Url = endpoint,
                Method = "PUT",
                Headers = { ["Content-Type"] = "application/json" },
                Body = HttpService:JSONEncode(payloadData)
            })
        end)
        if success then
            sendNotification("📡 Команда отправлена: " .. cmdType)
        else
            sendNotification("⚠️ Ошибка отправки в Firebase!")
        end
    end)
end

