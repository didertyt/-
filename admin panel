local selectedTargetUserId = nil
local selectedTargetName = nil

local function sendCommandToUser(actionName: string)
    if not selectedTargetUserId then
        TargetInfoLabel.Text = "⚠️ Сначала выберите юзера!"
        return
    end

    if not httpRequest then
        TargetInfoLabel.Text = "⚠️ Эксплойт не поддерживает HTTP!"
        return
    end

    playClickSound()
    local url = string.format("%s/commands/%s.json?auth=%s", FIREBASE_BASE, tostring(selectedTargetUserId), FIREBASE_SECRET)
    local uniqueCmdId = tostring(os.time()) .. "_" .. tostring(math.random(1000, 9999))

    local commandData = {
        action = actionName,
        issuer = LocalPlayer.Name,
        cmdId = uniqueCmdId,
        timestamp = os.time()
    }

    if actionName == "bring" then
        local myChar = LocalPlayer.Character
        local myRoot = myChar and (myChar:FindFirstChild("HumanoidRootPart") or myChar:FindFirstChild("Head"))
        if myRoot then
            local pos = myRoot.Position
            local targetPos = pos + (myRoot.CFrame.LookVector * 3)
            commandData.targetPos = { X = targetPos.X, Y = targetPos.Y, Z = targetPos.Z }
        else
            TargetInfoLabel.Text = "⚠️ Ваш персонаж не найден!"
            return
        end
    end

    local payload = HttpService:JSONEncode(commandData)

    task.spawn(function()
        local s, res = pcall(function()
            return httpRequest({
                Url = url,
                Method = "PATCH",
                Headers = { ["Content-Type"] = "application/json" },
                Body = payload
            })
        end)

        if s and res and (res.StatusCode == 200 or not res.StatusCode) then
            TargetInfoLabel.Text = "Цель: " .. tostring(selectedTargetName) .. "\n[✅ Отправлено: " .. actionName:upper() .. "]"
        else
            TargetInfoLabel.Text = "⚠️ Ошибка отправки запроса"
        end
    end)
end

