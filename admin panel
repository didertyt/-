local function refreshOnlineHubUsers()
    if not httpRequest then return end

    local success, res = pcall(function()
        return httpRequest({ Url = PRESENCE_ENDPOINT, Method = "GET" })
    end)

    if not (success and res and res.Body and res.Body ~= "null") then return end

    local decodeOk, activeUsersData = pcall(function()
        return HttpService:JSONDecode(res.Body)
    end)

    if not (decodeOk and type(activeUsersData) == "table") then return end

    local now = os.time()
    local validUsers = {}

    for idStr, data in pairs(activeUsersData) do
        local uid = tonumber(idStr) or (data and data.userId)
        if uid and uid ~= LocalPlayer.UserId and data.lastSeen and (now - data.lastSeen) <= 25 then
            table.insert(validUsers, {
                userId = uid,
                name = data.name or ("ID: " .. tostring(uid)),
                displayName = data.displayName or data.name or "User"
            })
        end
    end

    for _, child in ipairs(UsersScrolling:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    table.clear(adminUserRows)

    if #validUsers == 0 then
        local emptyLabel = Instance.new("TextLabel")
        emptyLabel.Name = "EmptyLabel"
        emptyLabel.Size = UDim2.new(1, 0, 0, 30)
        emptyLabel.BackgroundTransparency = 1
        emptyLabel.ZIndex = 15
        emptyLabel.Text = "⏳ Нет активных юзеров хаба на сервере..."
        emptyLabel.Font = Enum.Font.GothamMedium
        emptyLabel.TextSize = 10
        emptyLabel.TextColor3 = Color3.fromRGB(160, 130, 190)
        emptyLabel.Parent = UsersScrolling
        return
    end

    for _, user in ipairs(validUsers) do
        local isSelected = (selectedAdminTargetId == user.userId)
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, -8, 0, 30)
        btn.BackgroundColor3 = isSelected and Color3.fromRGB(80, 25, 140) or Color3.fromRGB(40, 20, 70)
        btn.BackgroundTransparency = isSelected and 0.1 or 0.5
        btn.BorderColor3 = Color3.fromRGB(255, 100, 255)
        btn.BorderSizePixel = isSelected and 2 or 0
        btn.ZIndex = 15
        btn.Text = "  🟢 " .. user.name .. " (@" .. user.displayName .. ")"
        btn.Font = isSelected and Enum.Font.GothamBold or Enum.Font.GothamMedium
        btn.TextSize = 10
        btn.TextXAlignment = Enum.TextXAlignment.Left
        btn.TextColor3 = isSelected and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(210, 170, 255)
        btn.Parent = UsersScrolling

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 4)
        corner.Parent = btn

        bindButton(btn, function()
            playClickSound()
            selectedAdminTargetId = user.userId
            selectedAdminTargetName = user.name

            for _, b in pairs(adminUserRows) do
                b.BackgroundColor3 = Color3.fromRGB(40, 20, 70)
                b.BackgroundTransparency = 0.5
                b.BorderSizePixel = 0
                b.TextColor3 = Color3.fromRGB(210, 170, 255)
            end

            btn.BackgroundColor3 = Color3.fromRGB(80, 25, 140)
            btn.BackgroundTransparency = 0.1
            btn.BorderSizePixel = 2
            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            sendNotification("Выбран юзер: " .. user.name)
        end)

        adminUserRows[user.userId] = btn
    end
end

