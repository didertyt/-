local function refreshUsers()
    for _, ch in ipairs(UserScroll:GetChildren()) do
        if ch:IsA("TextButton") then ch:Destroy() end
    end

    if not httpRequest then return end
    local url = string.format("%s/users.json?auth=%s", FIREBASE_BASE, FIREBASE_SECRET)
    task.spawn(function()
        local s, res = pcall(function()
            return httpRequest({ Url = url, Method = "GET" })
        end)
        if s and res and res.Body and res.Body ~= "null" then
            local data = HttpService:JSONDecode(res.Body)
            if type(data) == "table" then
                local now = os.time()
                for uid, info in pairs(data) do
                    -- Показываем активных юзеров за последние 4 минуты (кроме самого себя)
                    if info.lastSeen and (now - info.lastSeen < 240) and uid ~= tostring(LocalPlayer.UserId) then
                        local userBtn = Instance.new("TextButton")
                        userBtn.Size = UDim2.new(1, -4, 0, 28)
                        userBtn.BackgroundColor3 = (selectedTargetUserId == uid) and Color3.fromRGB(80, 30, 135) or Color3.fromRGB(35, 18, 55)
                        userBtn.BackgroundTransparency = (selectedTargetUserId == uid) and 0.1 or 0.4
                        userBtn.BorderColor3 = Color3.fromRGB(200, 100, 255)
                        userBtn.BorderSizePixel = (selectedTargetUserId == uid) and 1 or 0
                        userBtn.Text = "  " .. (info.displayName or info.name) .. " (@" .. info.name .. ")"
                        userBtn.Font = Enum.Font.GothamMedium
                        userBtn.TextSize = 9
                        userBtn.TextColor3 = Color3.fromRGB(230, 200, 255)
                        userBtn.TextXAlignment = Enum.TextXAlignment.Left
                        userBtn.Parent = UserScroll

                        local btnCorner = Instance.new("UICorner")
                        btnCorner.CornerRadius = UDim.new(0, 4)
                        btnCorner.Parent = userBtn

                        userBtn.MouseButton1Click:Connect(function()
                            playClickSound()
                            selectedTargetUserId = tostring(uid)
                            selectedTargetName = info.name
                            TargetInfoLabel.Text = "🎯 Выбран:\n" .. info.name .. " (ID: " .. uid .. ")"
                            for _, child in ipairs(UserScroll:GetChildren()) do
                                if child:IsA("TextButton") then
                                    child.BorderSizePixel = (child == userBtn) and 1 or 0
                                    child.BackgroundColor3 = (child == userBtn) and Color3.fromRGB(80, 30, 135) or Color3.fromRGB(35, 18, 55)
                                end
                            end
                        end)
                    end
                end
            end
        end
    end)
end

